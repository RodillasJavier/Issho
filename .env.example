# Copy to `.env` and fill in. `.env` is gitignored.

# Public, RLS-gated client credential — the row level security policies are
# what protect user data, not the secrecy of this key. Get it from the Supabase
# dashboard: Settings -> API -> anon/public.
VITE_SUPABASE_ANON_KEY=

# Optional. Defaults to the production project when unset, so leave it blank
# unless you're pointing the app somewhere else.
# VITE_SUPABASE_URL=

# Optional. Only needed for direct-write runs of scripts/backfill-anilist.ts
# (Settings -> API -> service_role). `--dry-run` and `--emit-sql` don't need it.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional. Where the RLS suite (`npm run test:rls`) looks for Postgres.
# Defaults to the container `npm run db:up` starts.
# RLS_DATABASE_URL=postgresql://postgres:postgres@localhost:55432/postgres
